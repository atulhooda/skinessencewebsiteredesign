# Canonical site origin used for metadata, sitemap, robots and JSON-LD. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://skinessence2017.com

# Google Tag Manager container (brief 9.12). Leave empty to render no GTM script.
NEXT_PUBLIC_GTM_ID=

# Google Business Profile Place ID (brief 9.11). Enables the "Read our reviews on Google" link + widget slot.
NEXT_PUBLIC_GOOGLE_PLACE_ID=

# Funnel Agent analytics. This key is publishable, not a secret, and is also the
# built-in default, so tracking works without setting anything here. Set it to an
# empty value to switch tracking off, or to another key to use another workspace.
NEXT_PUBLIC_FUNNEL_KEY=wk_52e3aff27656e23165691b6a
NEXT_PUBLIC_FUNNEL_API=https://funnel-agent-production-85a3.up.railway.app
