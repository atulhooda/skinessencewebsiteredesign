{
  "name": "skin-essence-website",
  "version": "0.1.0",
  "private": true,
  "description": "Skin Essence — MD Dermatologist in Kalyani Nagar, Pune. Static Next.js site generated from typed content in /content.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "images:placeholders": "node scripts/generate-placeholders.mjs",
    "check": "npm run content:check && npm run typecheck && npm run lint && npm run build",
    "content:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-content.ts",
    "qr": "node scripts/generate-qr.mjs"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^15.5.25",
    "@next/third-parties": "^15.5.25",
    "next": "15.5.25",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.25",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
